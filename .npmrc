confirmModulesPurge=false
# Without this, pnpm silently runs `pnpm install --production` (wiping
# devDependencies like electron-vite/@nestjs/cli) whenever it thinks
# node_modules is out of sync with the lockfile — which the bundle:server
# script's own `pnpm deploy --prod` step reliably triggers for every pnpm
# command that runs afterward. Cost this project its devDependencies twice.
verify-deps-before-run=false
