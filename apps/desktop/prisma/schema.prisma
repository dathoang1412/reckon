generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// Local-first storage: every table mirrors the shared zod schemas in
// @reckon/shared and carries updatedAt/deviceId/deletedAt so the sync
// engine can turn rows into SyncChange records untouched.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model VocabEntry {
  id         String    @id
  sourceText String
  sourceLang String
  targetText String
  // JSON-encoded string[] of alternative meanings (targetText is always
  // meanings[0]) — kept as a plain column rather than a relation table
  // since SQLite has no native array type and this schema stays
  // loosely-coupled/sync-friendly like the rest of the file.
  targetMeanings String?
  targetLang String
  definition String?
  note       String?
  tags       String?
  // AI-generated (Groq) enrichment — all optional/nullable, populated
  // on-demand from VocabDetailModal rather than at save time, so a row
  // with none of these is just a word nobody has asked for AI help with
  // yet. examples/relatedWords are JSON-encoded (see aiTypes.ts), same
  // reasoning as targetMeanings/tags above.
  aiExamples     String?
  aiNuance       String?
  aiRelatedWords String?
  // References VocabSet.id — not a Prisma relation, matching the rest of
  // this schema's loosely-coupled, sync-friendly style.
  setId      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  deviceId   String
  deletedAt  DateTime?
}

// A user-named grouping of VocabEntry rows. One set per entry (VocabEntry
// only carries a single setId), not multi-tag membership.
model VocabSet {
  id        String    @id
  name      String
  updatedAt DateTime
  deviceId  String
  deletedAt DateTime?
}

// Singleton row (id 1) tracking the last successful pull, so sync only
// asks the server for changes since then.
model SyncState {
  id           Int       @id @default(1)
  lastPulledAt DateTime?
}

// Spaced-repetition state for a VocabEntry. Kept as a separate table
// (not a relation) so it stays optional per entry, matching the rest
// of the schema's loosely-coupled style — a row only exists once a
// user starts reviewing that word.
model ReviewState {
  vocabId        String    @id
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
}
