generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generic store for every syncable entity (task/note/expense/...).
// Keeping the server schema entity-agnostic means adding a new local
// entity type never requires a server migration — only the `kind`
// string and the shape of `data` change.
//
// userId is nullable, and the PK is intentionally still (kind, recordId)
// even after auth landed: ids are client-generated UUIDs, so cross-user
// collision risk is effectively zero, and avoiding a PK migration means
// pre-auth records (userId = NULL) are left alone instead of requiring a
// backfill. Records written from here on always carry userId. Moving to a
// real (userId, kind, recordId) PK is deferred until it's actually needed.
model SyncRecord {
  kind      String
  recordId  String
  userId    String?
  deviceId  String
  updatedAt DateTime
  deletedAt DateTime?
  data      Json

  @@id([kind, recordId])
  @@index([updatedAt])
  @@index([userId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Nullable — a Google-only account (see AuthService.googleLogin) never
  // sets one. Email/password login/signup still requires it be present.
  passwordHash String?
  // Google's "sub" claim — stable, unique per Google account, unlike email
  // (which a user could theoretically change on Google's side).
  googleId     String?  @unique
  name         String?
  // Small (resized/compressed client-side, see Settings.tsx) avatar image
  // as a data: URI — see the "Lưu ảnh đại diện ở đâu" decision in-repo:
  // apps/server isn't a persistent hosted service (each user runs their
  // own copy locally, see server.ts), so Postgres is the only actually
  // shared/durable place to put this.
  avatarBase64 String?
  createdAt    DateTime @default(now())
  devices      Device[]
}

// id matches the client-generated deviceId already used throughout
// the sync engine, so wiring auth in later just means stamping each
// device row with the authenticated user instead of introducing a
// new identifier.
model Device {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  label      String?
  lastSeenAt DateTime?
}
