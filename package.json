{
  "name": "reckon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reckon - local-first desktop app with cloud sync",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev:server": "pnpm --filter @reckon/server dev",
    "dev:desktop": "pnpm --filter @reckon/desktop dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.65.0"
  }
}
